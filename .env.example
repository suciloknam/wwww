# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model IDs: check each provider's current model list and paste the exact ID.
# Swapping models = edit this file + `docker compose up -d`. No code change.
CLAUDE_MODEL=
OPENAI_MODEL=

# Order = primary first, then fallbacks
PROVIDER_ORDER=claude,openai

# USD per 1M tokens — copy from each provider's pricing page for the models above
CLAUDE_PRICE_IN=0
CLAUDE_PRICE_OUT=0
OPENAI_PRICE_IN=0
OPENAI_PRICE_OUT=0

MAX_LOG_CHARS=8000
